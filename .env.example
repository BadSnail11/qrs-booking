# ── SMS (smsc.by) ─────────────────────────────────────────────────────────
SMS_CENTRE_LOGIN=
SMS_CENTRE_PASSWORD=
SMS_CENTRE_SENDER=booking.mise.by
SMS_REMINDER_HOURS_BEFORE=2
