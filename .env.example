# ── Restaurant ────────────────────────────────────────────────────────────
RESTAURANT_TZ=Europe/Moscow

# ── Admin auth ────────────────────────────────────────────────────────────
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME_RANDOM_STRING
