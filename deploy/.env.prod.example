# Copy to deploy/.env.prod and fill in real values:
#   cp deploy/.env.prod.example deploy/.env.prod

# ── Public site (required for HTTPS) ──────────────────────────────────────
# A-record / AAAA-record must point to this VM's public IP before first start.
DOMAIN=booking.example.com
ACME_EMAIL=you@example.com
ADMIN_WEB_URL=https://booking.example.com/admin

# ── Database (required) ───────────────────────────────────────────────────
DB_NAME=qrs_booking
DB_USER=qrs_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── Admin auth (required) ─────────────────────────────────────────────────
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING
PHONE_VERIFICATION_SALT=CHANGE_ME_ANOTHER_RANDOM_STRING

# ── Restaurant ────────────────────────────────────────────────────────────
RESTAURANT_TZ=Europe/Moscow
OPEN_HOUR=11
CLOSE_HOUR=22
SLOT_MINUTES=120

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=QRS Booking

# ── SMS (smsc.by) ─────────────────────────────────────────────────────────
SMS_CENTRE_LOGIN=
SMS_CENTRE_PASSWORD=
SMS_CENTRE_SENDER=booking.mise.by
SMS_REMINDER_HOURS_BEFORE=2
SMS_REMINDER_INTERVAL_SECONDS=60

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── iiko ──────────────────────────────────────────────────────────────────
# Organization key (applied on first DB init only → restaurants.iiko_api_login)
IIKO_API_LOGIN=
IIKO_ORGANIZATION_ID=
IIKO_TERMINAL_GROUP_ID=
# App credentials from https://public-api.iikoweb.ru/portal (required at runtime)
IIKO_APP_ID=
IIKO_CLIENT_SECRET=
IIKO_SYNC_INTERVAL_SECONDS=300
IIKO_SYNC_DAYS_AHEAD=14
